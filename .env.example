# =====================================================
# GeoTrack Pro — environment variables
# =====================================================
# COPY THIS FILE TO .env ONLY IF YOU NEED IT.
#
# The default deployment requires NO environment variables.
# Netlify Blobs is provided automatically by the Netlify
# runtime, and the IP geolocation proxy needs no key.
#
# The variables below are OPTIONAL and only apply if you
# choose to use Firebase instead of the built-in backend.
#
# NEVER commit your real .env file.
# =====================================================

# ------ Optional: Firebase Realtime Database ------
# Only needed if you want push-based multi-device sync.
# Otherwise leave everything blank.
#
# Note: this project is a static site with no build step,
# so these values are normally placed directly in
# public/firebase-config.js instead. Use this file only
# if you later add a bundler (Vite/Next.js).

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ------ Local development only ------
# Change the port used by `node server.js` (default 8790).
PORT=8790
